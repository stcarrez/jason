with "jason_config";
with "utilada_sys";
with "elada";
with "asf";
with "servletada_aws";
with "ado";
with "ado_all";
with "awa";
with "awa_workspaces";
with "awa_mail";
with "awa_comments";
with "awa_blogs";
with "awa_storages";
with "awa_tags";
with "awa_wikis";
with "jason";

project jason_server is

   Mains := ("jason-server.adb");
   for Main use Mains;
   for Source_Dirs use ("src");
   for Object_Dir use "../" & Jason_Config'Object_Dir & "/obj/server";
   for Exec_Dir use "../" & Jason_Config'Exec_Dir & "/bin";

   package Binder renames Jason_Config.Binder;
   package Builder renames Jason_Config.Builder;
   package Compiler renames Jason_Config.Compiler;
   package Linker renames Jason_Config.Linker;

end jason_server;
