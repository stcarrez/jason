with "jason_config";
with "jason";
with "utilada_sys";
with "utilada_unit";
with "elada";
with "asf";
with "asf_unit";
with "ado";
with "awa";
with "awa_unit";
with "awa_workspaces";
with "awa_mail";
with "awa_comments";
with "awa_blogs";
with "awa_storages";
with "jason";
with "jason_server";

project Jason_Tests is

   Mains := ("jason_harness.adb");
   for Main use Mains;
   for Source_Dirs use ("src");
   for Object_Dir use "./" & Jason_Config'Object_Dir & "/obj";
   for Exec_Dir use "./" & Jason_Config'Exec_Dir & "/bin";

   package Binder renames Jason_Config.Binder;
   package Builder renames Jason_Config.Builder;
   package Compiler renames Jason_Config.Compiler;
   package Linker renames Jason_Config.Linker;

end Jason_Tests;
