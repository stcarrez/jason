with "jason_config";
with "utilada_sys";
with "elada";
with "asf";
with "ado";
with "awa";
with "awa_workspaces";
with "awa_mail";
with "awa_comments";
with "awa_storages";
with "awa_tags";
with "awa_wikis";

library project jason is

   Name    := "jason";
   Version := "0.2.0";
   Library_Dir := "lib";
   Library_Type : Jason_Config.Library_Type_Type := external ("JASON_LIBRARY_TYPE", "static");

   for Source_Dirs use ("src", "src/model");

   for Library_Name use Name;
   for Library_Kind use Library_Type;
   for Library_Version use "lib" & Project'Library_Name & ".so." & Version;

   for Library_Dir use "lib/" & Project'Library_Name & "/" & Project'Library_Kind;
   for Object_Dir use "obj/" & Project'Library_Name & "/" & Project'Library_Kind;

   package Binder renames Jason_Config.Binder;
   package Builder renames Jason_Config.Builder;
   package Compiler renames Jason_Config.Compiler;

end jason;
